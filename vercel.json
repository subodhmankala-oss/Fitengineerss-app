{
  "crons": [
    { "path": "/api/send-nudges", "schedule": "30 2 * * *" },
    { "path": "/api/send-nudges", "schedule": "30 5 * * *" },
    { "path": "/api/send-nudges", "schedule": "30 7 * * *" },
    { "path": "/api/send-nudges", "schedule": "0 14 * * *" },
    { "path": "/api/send-nudges", "schedule": "0 16 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/auth/confirm", "destination": "/index.html" }
  ]
}
